<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>XauStudio</AssemblyName><Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PortablePayload)" LogicalName="XauStudio.PortablePayload.zip" Condition="'$(PortablePayload)' != ''" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2535.41" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <Compile Include="../source/XAU/Util/XboxAuthNet/**/*.cs" Exclude="../source/XAU/Util/XboxAuthNet/obj/**;../source/XAU/Util/XboxAuthNet/bin/**;../source/XAU/Util/XboxAuthNet/Platforms/**;../source/XAU/Util/XboxAuthNet/PlatformManager.cs;../source/XAU/Util/XboxAuthNet/OAuth/CodeFlow/CodeFlowBuilder.cs" Link="Auth/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
